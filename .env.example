# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/asset-manager

# JWT secrets - use strong random values in production
JWT_ACCESS_SECRET=replace_with_a_strong_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_strong_refresh_secret

# Token lifetime values
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Server settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Optional seeded admin values
SEED_EMAIL=admin@gmail.com
SEED_PASSWORD=admin@123
SEED_NAME=Admin
